# ── Testnet RPC URLs ──────────────────────────────────────────────────────────
# Get a free key from: https://www.alchemy.com or https://www.infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Distribution mode for scripts/deploy.js and scripts/simulate.js ──────────
# Allowed values: v1 (default), v2
DISTRIBUTION_MODE=v1

# ── Deployer Private Key ──────────────────────────────────────────────────────
# Export from MetaMask → Account Details → Export Private Key
# DO NOT include the 0x prefix. DO NOT commit this file.
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# ── Block Explorer API Keys (for contract verification) ───────────────────────
# Etherscan: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key
# Polygonscan: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key
