# ─────────────────────────────────────────────────────────────────────────────
#  Real Estate Tokenization — environment template
#  Copy to `.env` (which is .gitignored). NEVER commit `.env`.
#  NEVER paste real private keys into chat, screenshots, or commits.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# NETWORK — Base Sepolia (UGF Hackathon target, chain id 84532)
# =============================================================================
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# =============================================================================
# OTHER NETWORKS (kept for backward compatibility)
# =============================================================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# =============================================================================
# DEPLOYER WALLET
# =============================================================================
# NO 0x prefix. The bare 64-hex private key only.
# Hardhat config prepends 0x at runtime. Never commit a real value.
PRIVATE_KEY=
DEPLOYER_WALLET_ADDRESS=

# =============================================================================
# DEMO INVESTOR WALLET (used by scripts/seedDemo.js)
# =============================================================================
# A second MetaMask account, intentionally kept at 0 ETH for the hackathon demo.
# Phase 1E (seedDemo.js) mints USDC, buys PROP, and seeds pending rent into
# this wallet so the 60-second pitch is reproducible.
DEMO_INVESTOR_PRIVATE_KEY=
DEMO_INVESTOR_WALLET_ADDRESS=

# Optional: address that receives the demo investor's residual ETH after the
# seed run, so the demo wallet truly ends with 0 ETH. Leave blank to print a
# "manual sweep needed" notice instead.
BASE_SEPOLIA_GAS_DUST_ADDRESS=

# =============================================================================
# DISTRIBUTION MODE for scripts/deploy.js and scripts/simulate.js
# =============================================================================
# v1 = RentalDistribution.sol  (epoch-loop claims; use this for the hackathon)
# v2 = RentalDistributionV2.sol (constant-time claims; research surface only)
DISTRIBUTION_MODE=v1

# =============================================================================
# BLOCK EXPLORER API KEYS (only for `npx hardhat verify`)
# =============================================================================
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=

# =============================================================================
# CONTRACTS — populated automatically after `npm run deploy:base`
# (or paste the addresses manually if you skip the env-override path)
# =============================================================================
VITE_MOCK_USDC_ADDRESS=
VITE_PROPERTY_FACTORY_ADDRESS=

# =============================================================================
# FRONTEND (Vite — only VITE_-prefixed vars reach the browser)
# =============================================================================
# baseSepolia (default) = chain 84532. local = chain 31337 (Hardhat node).
VITE_NETWORK_MODE=baseSepolia
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Express backend URL the frontend POSTs to for the activity feed (Tier 2 / 5C)
VITE_BACKEND_URL=http://localhost:5000

# Static ETH/USD rate used by the Tier 2 cost banner. Override only if you want.
VITE_ETH_USD_RATE=2000

# Tier 3 / 6.1 — embedded wallet (Privy). OPTIONAL. Leave blank to keep the
# MetaMask-only flow exactly as it is today. Set this to your Privy App ID
# (free tier at https://dashboard.privy.io) to enable "sign in with email /
# Google" on the Landing page. When set, Privy creates an embedded wallet for
# users without one and exposes it as window.ethereum so the existing
# Web3Context picks it up untouched.
VITE_PRIVY_APP_ID=

# =============================================================================
# BACKEND (Express + MongoDB)
# Backend degrades gracefully when MongoDB is offline. Tier 1 does NOT need it.
# =============================================================================
BACKEND_PORT=5000
MONGODB_URI=mongodb://localhost:27017/realchain
JWT_SECRET=

# Backend logging — pino level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info
# NODE_ENV=production switches off pino-pretty and ships raw JSON logs
NODE_ENV=development

# Event indexer (jobs/indexer.js). When true, the backend polls the chain
# every 12s for the property/marketplace/distribution events and persists
# authoritative records into Mongo (replaces unverified client-posted txs).
# Requires deployed-addresses.json to point at a real factory.
ENABLE_INDEXER=false
# Block-range chunk for getLogs. Base Sepolia free tier caps this at 10;
# raise to 1000–5000 on a paid RPC for faster catch-up.
INDEXER_CHUNK_BLOCKS=10
